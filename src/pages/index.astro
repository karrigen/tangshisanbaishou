---
// 自动读取根目录下的所有 Markdown 诗词文件
const rawPoems = await Astro.glob('../poems/*.md');

const allPoems = rawPoems.map((poem, i) => ({
  data: poem.frontmatter,
  body: poem.rawContent(),
  index: i + 1,
}));
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>唐诗三百首 · 诗画卷</title>
  <script>
    // 用 JavaScript 直接读取浏览器真实可视区域尺寸，写入 CSS 变量。
    // 比依赖 vh/dvh/svh 更可靠——不同浏览器（尤其 Brave 等）对这些视口单位的
    // 实现细节不完全一致，读 visualViewport 拿到的才是"眼睛实际看到的区域"。
    (function () {
      function setViewportVars() {
        var vv = window.visualViewport;
        var w = vv ? vv.width : window.innerWidth;
        var h = vv ? vv.height : window.innerHeight;
        document.documentElement.style.setProperty('--vvw', w + 'px');
        document.documentElement.style.setProperty('--vvh', h + 'px');
      }
      setViewportVars();
      window.addEventListener('resize', setViewportVars);
      window.addEventListener('orientationchange', setViewportVars);
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', setViewportVars);
        window.visualViewport.addEventListener('scroll', setViewportVars);
      }
    })();
  </script>
  <style>
    :root {
      --ink: #1b2027;        /* 深靛墨色，替代纯黑遮罩 */
      --paper: #f2ede1;      /* 宣纸白 */
      --seal: #c9a227;       /* 印泥金 */
      --seal-dim: rgba(201, 162, 39, 0.35);
      /* JS 加载前的兜底值，JS 一运行会立刻用真实像素值覆盖 */
      --vvw: 100vw;
      --vvh: 100vh;
    }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html, body {
      margin: 0; padding: 0; height: 100%;
      font-family: "Kaiti SC", "STKaiti", "楷体", serif;
      background: #0b0d10;
      color: var(--paper);
      overflow: hidden;
    }

    /* ---------- 舞台：铺满真实可视区域，负责在桌面端居中卡片 ---------- */
    .stage {
      position: fixed;
      top: 0;
      left: 0;
      width: var(--vvw);
      height: var(--vvh);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #0b0d10;
    }

    /* 铺满整个视口的模糊背景——始终可见，图片比例和窗口比例不一致时用它填补空白，
       而不是让人看见生硬的黑边 */
    .backdrop {
      position: absolute;
      inset: -60px;
      background-size: cover;
      background-position: center;
      filter: blur(50px) brightness(0.5) saturate(1.15);
      transform: scale(1.15);
      transition: background-image 0.45s ease;
      z-index: 0;
    }

    /* ---------- 卡片：始终保持诗配图真实的比例（853:1844，约等于主流手机全面屏比例），
       在任何屏幕尺寸下自动取"能放下的最大同比例矩形"，多余空间露出模糊背景，
       绝不会裁掉图中的文字或人物。尺寸基于 JS 测得的真实可视区域（--vvw/--vvh），
       不再依赖各浏览器实现不一致的 vh/dvh/svh 单位 ---------- */
    .frame {
      position: relative;
      z-index: 1;
      width: min(var(--vvw), var(--vvh) * 853 / 1844);
      height: min(var(--vvh), var(--vvw) * 1844 / 853);
      overflow: hidden;
      background: #000;
    }

    /* ---------- 全屏纵向滑动画卷 ---------- */
    .poem-scroll {
      height: 100%;
      width: 100%;
      overflow-y: scroll;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;        /* Firefox */
      -ms-overflow-style: none;     /* 旧版 Edge/IE */
    }
    .poem-scroll::-webkit-scrollbar { display: none; } /* Chrome/Safari */
    .poem-page {
      position: relative;
      height: 100%;
      width: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      overflow: hidden;
      cursor: pointer;
    }

    .poem-page .bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
      z-index: 0;
    }

    /* 手机端：宽度始终铺满，浏览器地址栏占用的高度差直接从图片底部裁掉，
       顶部（含题字）保持完整，不再整体缩小、不再露出黑边 */
    @media (max-width: 700px) {
      .frame {
        width: var(--vvw) !important;
        height: var(--vvh) !important;
      }
      .poem-page .bg {
        object-fit: cover;
        object-position: center top;
      }
      .backdrop { display: none; }
    }

    /* 默认纯图片，点按后才淡入遮罩与诗文 */
    .poem-page .scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(20,22,28,0.78) 0%, rgba(20,22,28,0.4) 40%, transparent 66%);
      z-index: 1;
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
    }
    .poem-page.info-open .scrim { opacity: 1; }

    /* ---------- 竖排诗文卷轴（点击后显示） ---------- */
    .scroll-panel {
      position: absolute;
      top: 10%;
      bottom: 10%;
      left: 20px;
      z-index: 2;
      display: flex;
      flex-direction: row-reverse; /* 传统由右向左排列诗行 */
      gap: 14px;
      align-items: stretch;
      opacity: 0;
      transform: translateX(-8px);
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: none;
    }
    .poem-page.info-open .scroll-panel {
      opacity: 1;
      transform: translateX(0);
    }
    .scroll-panel .poem-text {
      writing-mode: vertical-rl;
      font-size: clamp(1.05rem, 4vw, 1.35rem);
      line-height: 2.05;
      letter-spacing: 0.12em;
      white-space: pre-line;
      text-shadow: 0 2px 10px rgba(0,0,0,0.55);
    }
    .scroll-panel .title-block {
      writing-mode: vertical-rl;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding-left: 6px;
      border-left: 1px solid var(--seal-dim);
    }
    .scroll-panel .title-block h3 {
      margin: 0;
      font-size: clamp(1.3rem, 5vw, 1.7rem);
      font-weight: 600;
      text-shadow: 0 2px 10px rgba(0,0,0,0.6);
    }
    /* 作者 · 体裁：换成米白色文字 + 半透明深色胶囊底，
       不管压在多亮/多花的背景图上，对比度都是稳定的，不再依赖图片本身的颜色 */
    .scroll-panel .title-block .meta {
      font-size: 0.8rem;
      color: #f4e9d6;
      letter-spacing: 0.08em;
      background: rgba(20, 22, 28, 0.6);
      padding: 10px 6px;
      border-radius: 999px;
      box-shadow: 0 3px 10px rgba(0,0,0,0.35), inset 0 0 0 1px rgba(244,233,214,0.18);
    }

    /* ---------- 左下角操作栏：点赞 + 朗读 ---------- */
    .action-bar {
      position: absolute;
      left: 20px;
      bottom: calc(20px + env(safe-area-inset-bottom));
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .like-btn, .read-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(20, 22, 28, 0.55);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 999px;
      padding: 8px 14px;
      cursor: pointer;
      color: var(--paper);
      font-family: inherit;
      font-size: 0.85rem;
      transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .like-btn:active, .read-btn:active {
      transform: scale(0.9);
    }
    .like-btn .heart-icon {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: #f4e9d6;
      stroke-width: 2;
      transition: fill 0.2s ease, stroke 0.2s ease, transform 0.2s ease;
    }
    .like-btn.liked .heart-icon {
      fill: #e0455f;
      stroke: #e0455f;
      transform: scale(1.12);
    }
    .like-btn .like-count {
      min-width: 1.1em;
    }
    .read-btn .speaker-icon {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: #f4e9d6;
      stroke-width: 2;
      transition: stroke 0.2s ease;
    }
    .read-btn.reading {
      background: rgba(201, 162, 39, 0.35);
      border-color: var(--seal);
    }
    .read-btn.reading .speaker-icon {
      stroke: var(--seal);
    }

    /* ---------- 右下角搜索按钮 ---------- */
    .search-fab {
      position: fixed;
      right: 20px;
      bottom: calc(20px + env(safe-area-inset-bottom));
      z-index: 10;
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(27, 32, 39, 0.55);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(201, 162, 39, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .search-fab svg {
      width: 22px;
      height: 22px;
      stroke: var(--seal);
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .search-fab:hover {
      background: rgba(27, 32, 39, 0.75);
      border-color: var(--seal);
    }
    .search-fab:active {
      transform: scale(0.92);
    }

    /* ---------- 搜索面板 ---------- */
    .search-panel {
      position: fixed;
      inset: 0;
      z-index: 20;
      background: rgba(17,19,24,0.97);
      transform: translateY(100%);
      transition: transform 0.32s ease;
      display: flex;
      flex-direction: column;
      padding: 20px;
      color: var(--paper);
    }
    .search-panel.open { transform: translateY(0); }

    .search-panel-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .search-panel-header input {
      flex: 1;
      padding: 10px 14px;
      font-size: 1rem;
      border-radius: 20px;
      border: 1px solid #555;
      background: var(--paper);
      color: #222;
      font-family: inherit;
    }
    .search-panel-header .close-btn {
      background: none;
      border: none;
      color: var(--paper);
      font-size: 1.7rem;
      cursor: pointer;
      line-height: 1;
      padding: 0 4px;
    }

    .filters {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .filters button {
      padding: 6px 14px;
      border-radius: 16px;
      border: 1px solid #666;
      background: transparent;
      color: var(--paper);
      font-size: 0.9rem;
      cursor: pointer;
      font-family: inherit;
    }
    .filters button.active {
      background: var(--seal);
      color: #201a08;
      border-color: var(--seal);
    }

    .result-list { overflow-y: auto; flex: 1; }
    .result-item {
      padding: 12px 8px;
      border-bottom: 1px solid rgba(255,255,255,0.12);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
    }
    .result-item .r-title { font-size: 1.05rem; }
    .result-item .r-meta { font-size: 0.82rem; opacity: 0.65; white-space: nowrap; }
    .result-empty {
      text-align: center;
      opacity: 0.6;
      padding: 30px 0;
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .poem-scroll { scroll-behavior: auto; }
      .search-panel { transition: none; }
    }
  </style>
</head>
<body>

  <div class="stage">
    <div class="backdrop" id="backdrop"></div>
    <div class="frame">
      <div class="poem-scroll" id="poemScroll">
        {allPoems.map((poem) => (
          <section
            class="poem-page"
            data-index={poem.index}
            data-title={poem.data.title}
            data-author={poem.data.author}
            data-form={poem.data.form}
          >
            <img class="bg" src={poem.data.coverImage} alt={poem.data.title} loading={poem.index === 1 ? 'eager' : 'lazy'} />
            <div class="scrim"></div>
            <div class="scroll-panel">
              <div class="title-block">
                <h3>{poem.data.title}</h3>
                <div class="meta">{poem.data.author} · {poem.data.form}</div>
              </div>
              <div class="poem-text">{poem.body}</div>
            </div>
            <div class="action-bar">
              <button
                class="like-btn"
                data-poem-id={poem.data.title}
                aria-label="点赞"
              >
                <svg class="heart-icon" viewBox="0 0 24 24">
                  <path d="M12 21s-6.7-4.3-9.3-8.2C1 10.1 1.5 6.8 4 5.1c2-1.4 4.6-1 6.2.9.6.7 1.1 1.5 1.8 1.5s1.2-.8 1.8-1.5c1.6-1.9 4.2-2.3 6.2-.9 2.5 1.7 3 5 1.3 7.7C18.7 16.7 12 21 12 21z"/>
                </svg>
                <span class="like-count">0</span>
              </button>

              <button class="read-btn" aria-label="朗读">
                <svg class="speaker-icon" viewBox="0 0 24 24">
                  <path d="M11 5 6 9H3v6h3l5 4V5z"/>
                  <path d="M15.5 8.5a5 5 0 0 1 0 7"/>
                  <path d="M18 6a9 9 0 0 1 0 12"/>
                </svg>
              </button>
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <button class="search-fab" id="searchFab" aria-label="搜索">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10.5" cy="10.5" r="6.5"></circle>
      <line x1="20" y1="20" x2="15.4" y2="15.4"></line>
    </svg>
  </button>

  <div class="search-panel" id="searchPanel">
    <div class="search-panel-header">
      <input type="text" id="quicksearch" placeholder="搜索诗名或作者..." />
      <button class="close-btn" id="closeSearch" aria-label="关闭">×</button>
    </div>
    <div class="filters" id="filterGroup">
      <button data-filter="*" class="active">全部</button>
      <button data-filter="五言绝句">五言绝句</button>
      <button data-filter="七言绝句">七言绝句</button>
    </div>
    <div class="result-list" id="resultList"></div>
    <div class="result-empty" id="resultEmpty">没有找到符合条件的诗</div>
  </div>

  <script is:inline>
    (function () {
      const scrollEl = document.getElementById('poemScroll');
      const pages = Array.from(document.querySelectorAll('.poem-page'));
      const backdrop = document.getElementById('backdrop');
      const fab = document.getElementById('searchFab');
      const panel = document.getElementById('searchPanel');
      const closeBtn = document.getElementById('closeSearch');
      const input = document.getElementById('quicksearch');
      const filterGroup = document.getElementById('filterGroup');
      const resultList = document.getElementById('resultList');
      const resultEmpty = document.getElementById('resultEmpty');

      let activeFilter = '*';
      let currentIndex = 0;

      // ---- 单击图片显示/隐藏诗文 ----
      pages.forEach((page) => {
        page.addEventListener('click', () => {
          const wasOpen = page.classList.contains('info-open');
          pages.forEach((p) => p.classList.remove('info-open'));
          if (!wasOpen) page.classList.add('info-open');
        });
      });

      // ---- 跟踪当前可见的诗页：同步桌面端模糊背景 + 记录方向键跳转的起点 ----
      {
        const setBackdrop = (page) => {
          if (!backdrop) return;
          const img = page.querySelector('.bg');
          if (img && img.src) backdrop.style.backgroundImage = 'url(' + img.src + ')';
        };
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
                currentIndex = pages.indexOf(entry.target);
                setBackdrop(entry.target);
              }
            });
          },
          { root: scrollEl, threshold: [0.6] }
        );
        pages.forEach((page) => io.observe(page));
        if (pages[0]) setBackdrop(pages[0]);
      }

      // ---- 桌面端方向键切换诗页（搜索面板打开时不拦截，方便正常打字） ----
      function goToIndex(idx) {
        if (idx < 0 || idx >= pages.length) return;
        pages[idx].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      document.addEventListener('keydown', (e) => {
        if (panel.classList.contains('open')) return;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === 'PageDown') {
          e.preventDefault();
          goToIndex(currentIndex + 1);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft' || e.key === 'PageUp') {
          e.preventDefault();
          goToIndex(currentIndex - 1);
        }
      });

      function openPanel() {
        panel.classList.add('open');
        renderResults();
        setTimeout(() => input.focus(), 300);
      }
      function closePanel() {
        panel.classList.remove('open');
      }
      fab.addEventListener('click', openPanel);
      closeBtn.addEventListener('click', closePanel);

      filterGroup.addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-filter]');
        if (!btn) return;
        activeFilter = btn.dataset.filter;
        filterGroup.querySelectorAll('button').forEach((b) => b.classList.toggle('active', b === btn));
        renderResults();
      });

      input.addEventListener('input', renderResults);

      // 搜索面板内的结果列表：仅用于快速跳转预览，不会隐藏或过滤主画卷中的其他诗页，
      // 跳转之后依然可以正常滑动/翻页到其余所有诗
      function renderResults() {
        const q = input.value.trim().toLowerCase();
        resultList.innerHTML = '';
        let matchCount = 0;

        pages.forEach((page) => {
          const title = page.dataset.title || '';
          const author = page.dataset.author || '';
          const form = page.dataset.form || '';

          const matchesFilter = activeFilter === '*' || form === activeFilter;
          const matchesQuery = !q || title.toLowerCase().includes(q) || author.toLowerCase().includes(q);

          if (matchesFilter && matchesQuery) {
            matchCount++;
            const item = document.createElement('div');
            item.className = 'result-item';
            item.innerHTML =
              '<span class="r-title">' + title + '</span>' +
              '<span class="r-meta">' + author + ' · ' + form + '</span>';
            item.addEventListener('click', () => {
              currentIndex = pages.indexOf(page);
              page.scrollIntoView({ behavior: 'smooth', block: 'start' });
              closePanel();
            });
            resultList.appendChild(item);
          }
        });

        resultEmpty.style.display = matchCount === 0 ? 'block' : 'none';
      }

      // ---- 点赞功能：数量存 Cloudflare KV（全站共享），本地只存"我是否点过" ----
      {
        const likeButtons = Array.from(document.querySelectorAll('.like-btn'));
        const pendingIds = new Set(); // 记录当前有请求还没返回的诗，防止连点产生竞态

        function getLikedSet() {
          try {
            return new Set(JSON.parse(localStorage.getItem('liked-poems') || '[]'));
          } catch {
            return new Set();
          }
        }
        function saveLikedSet(set) {
          localStorage.setItem('liked-poems', JSON.stringify(Array.from(set)));
        }

        const likedSet = getLikedSet();

        fetch('/api/likes')
          .then((res) => res.json())
          .then((counts) => {
            likeButtons.forEach((btn) => {
              const id = btn.dataset.poemId;
              const countEl = btn.querySelector('.like-count');
              countEl.textContent = counts[id] || 0;
              btn.classList.toggle('liked', likedSet.has(id));
            });
          })
          .catch((err) => console.error('加载点赞数失败', err));

        likeButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();

            const id = btn.dataset.poemId;

            // 这首诗上一个请求还没回来，直接忽略这次点击
            if (pendingIds.has(id)) return;
            pendingIds.add(id);
            btn.style.opacity = '0.6'; // 视觉上给个"处理中"的反馈，可选

            const countEl = btn.querySelector('.like-count');
            const alreadyLiked = likedSet.has(id);
            const action = alreadyLiked ? 'unlike' : 'like';

            const optimisticCount = (parseInt(countEl.textContent, 10) || 0) + (alreadyLiked ? -1 : 1);
            countEl.textContent = optimisticCount;
            btn.classList.toggle('liked', !alreadyLiked);
            if (alreadyLiked) {
              likedSet.delete(id);
            } else {
              likedSet.add(id);
            }
            saveLikedSet(likedSet);

            fetch('/api/likes', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, action }),
            })
              .then((res) => res.json())
              .then((data) => {
                countEl.textContent = data.count;
              })
              .catch((err) => {
                console.error('点赞请求失败', err);
                countEl.textContent = optimisticCount + (alreadyLiked ? 1 : -1);
                btn.classList.toggle('liked', alreadyLiked);
                if (alreadyLiked) likedSet.add(id); else likedSet.delete(id);
                saveLikedSet(likedSet);
              })
              .finally(() => {
                pendingIds.delete(id);
                btn.style.opacity = '1';
              });
          });
        });
      }

      // ---- 朗读功能：使用浏览器自带的语音合成，零后端成本 ----
      {
        const synth = window.speechSynthesis;
        let currentBtn = null;

        function stopReading() {
          synth.cancel();
          if (currentBtn) currentBtn.classList.remove('reading');
          currentBtn = null;
        }

        function pickChineseVoice() {
          const voices = synth.getVoices();
          return (
            voices.find((v) => v.lang === 'zh-CN') ||
            voices.find((v) => v.lang && v.lang.startsWith('zh')) ||
            null
          );
        }

        document.querySelectorAll('.read-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation(); // 防止冒泡触发诗页展开/收起

            if (!('speechSynthesis' in window)) {
              alert('抱歉，你的浏览器不支持朗读功能');
              return;
            }

            // 再点一次正在朗读的按钮 = 停止
            if (currentBtn === btn) {
              stopReading();
              return;
            }

            // 切换到另一首诗朗读，先停掉上一首
            stopReading();

            const page = btn.closest('.poem-page');
            const title = page.dataset.title || '';
            const author = page.dataset.author || '';
            const textEl = page.querySelector('.poem-text');
            const body = textEl ? textEl.textContent.trim() : '';

            const utterance = new SpeechSynthesisUtterance(title + '，' + author + '。' + body);
            utterance.lang = 'zh-CN';
            utterance.rate = 0.85; // 稍微放慢，古诗朗读更有味道

            const voice = pickChineseVoice();
            if (voice) utterance.voice = voice;

            utterance.onend = () => stopReading();
            utterance.onerror = () => stopReading();

            currentBtn = btn;
            btn.classList.add('reading');
            synth.speak(utterance);
          });
        });

        // Chrome 等浏览器第一次加载时语音列表是异步返回的，提前触发一次
        if (synth.getVoices().length === 0) {
          synth.addEventListener('voiceschanged', () => synth.getVoices(), { once: true });
        }

        // 滑动切换诗页时，停掉正在朗读的内容，避免声音和画面对不上
        scrollEl.addEventListener('scroll', () => {
          if (currentBtn) stopReading();
        });
      }
    })();
  </script>
</body>
</html>
