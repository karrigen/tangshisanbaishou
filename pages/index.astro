---
// 自动读取根目录下的所有 Markdown 诗词文件
const rawPoems = await Astro.glob('./*.md');

const allPoems = rawPoems.map(poem => ({
  data: poem.frontmatter,
  body: poem.rawContent()
}));
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>唐诗三百首 - 诗画鉴赏</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.isotope/3.0.6/isotope.pkgd.min.js"></script>
  <style>
    body { font-family: "Kaiti SC", "STKaiti", serif; background: #f4f0ea; color: #2b2b2b; margin: 0; padding: 20px; }
    header { text-align: center; margin-bottom: 20px; }
    .controls { display: flex; justify-content: center; gap: 15px; margin-bottom: 25px; flex-wrap: wrap; }
    input, select { padding: 8px 12px; font-size: 16px; border: 1px solid #ccc; border-radius: 4px; background: #fff; }
    
    .grid { margin: 0 auto; max-width: 1200px; }
    .grid-item { width: calc(33.333% - 20px); margin-bottom: 20px; box-sizing: border-box; }
    @media (max-width: 768px) { .grid-item { width: calc(50% - 10px); } }
    @media (max-width: 480px) { .grid-item { width: 100%; } }

    .card { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05); padding-bottom: 15px; }
    .card img { width: 100%; height: auto; display: block; }
    .card-content { padding: 15px; text-align: center; }
    .card h3 { margin: 0 0 5px 0; font-size: 1.2rem; }
    .card .meta { font-size: 0.9rem; color: #666; margin-bottom: 10px; }
    .card .poem-text { font-size: 1rem; line-height: 1.6; white-space: pre-line; }
  </style>
</head>
<body>

  <header>
    <h1>唐诗三百首</h1>
  </header>

  <div class="controls">
    <input type="text" id="quicksearch" placeholder="搜索诗名、作者或诗句..." />
    <select id="filter-form">
      <option value="*">所有体裁</option>
      <option value=".七言绝句">七言绝句</option>
      <option value=".五言绝句">五言绝句</option>
    </select>
  </div>

  <div class="grid">
    {allPoems.map(poem => (
      <div class={`grid-item ${poem.data.form}`} data-author={poem.data.author} data-title={poem.data.title} data-content={poem.body}>
        <div class="card">
          <img src={poem.data.coverImage} alt={poem.data.title} loading="lazy" />
          <div class="card-content">
            <h3>{poem.data.title}</h3>
            <div class="meta">[{poem.data.author}] · {poem.data.form}</div>
            <div class="poem-text">{poem.body}</div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <script is:inline>
    $(window).on('load', function() {
      var $grid = $('.grid').isotope({
        itemSelector: '.grid-item',
        percentPosition: true,
        masonry: { columnWidth: '.grid-item' }
      });

      $('#filter-form').on('change', function() {
        var filterValue = this.value;
        $grid.isotope({ filter: filterValue });
      });

      $('#quicksearch').on('keyup', function() {
        var qsRegex = new RegExp($('#quicksearch').val(), 'gi');
        $grid.isotope({
          filter: function() {
            var title = $(this).attr('data-title');
            var author = $(this).attr('data-author');
            var content = $(this).attr('data-content');
            return qsRegex ? (title + author + content).match(qsRegex) : true;
          }
        });
      });
    });
  </script>
</body>
</html>
